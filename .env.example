# Copy this file to .env and adjust the values:  cp .env.example .env
# .env is git-ignored; never commit real credentials.

# --- Project ---------------------------------------------------------------
COMPOSE_PROJECT_NAME=pro-monitor
RESTART_POLICY=unless-stopped

# --- Container logging (json-file driver) ----------------------------------
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# --- Sample application ----------------------------------------------------
APP_VERSION=1.0.0
APP_PORT=8000
APP_HOST_PORT=8000

# --- Fake log generator (sample app) ---------------------------------------
# Emits realistic business logs (auth, orders, payments...) to explore in Grafana
FAKE_LOGS_ENABLED=true
# Average seconds between log lines
FAKE_LOGS_INTERVAL_SECONDS=1.0
# Seconds between simulated error bursts (0 disables them)
FAKE_LOGS_INCIDENT_EVERY_SECONDS=300

# --- Image versions (pin explicit tags, avoid "latest") --------------------
PROMETHEUS_VERSION=v2.55.1
LOKI_VERSION=3.4.2
GRAFANA_AGENT_VERSION=v0.44.2
GRAFANA_VERSION=11.6.0
NODE_EXPORTER_VERSION=v1.9.1

# --- Host ports ------------------------------------------------------------
PROMETHEUS_HOST_PORT=9090
LOKI_HOST_PORT=3100
ALLOY_HOST_PORT=12345
GRAFANA_HOST_PORT=3000
NODE_EXPORTER_HOST_PORT=9100

# --- Prometheus ------------------------------------------------------------
PROMETHEUS_RETENTION=200h

# --- Grafana credentials (required) ----------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
